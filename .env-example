# Environment Configuration Example
# Copy this file to .env and update the values as needed

# Test Environment
NODE_ENV=local
LOG_LEVEL=INFO

# Application URLs
LOCAL_BASE_URL=http://192.168.78.48:4200/auth/login/
DEV_BASE_URL=http://localhost:3000
STAGING_BASE_URL=https://staging.example.com
PROD_BASE_URL=https://prod.example.com

# Browser Configuration
BROWSER=chromium
HEADLESS=false
SLOW_MO=0
TIMEOUT=30000
# Max time for one Cucumber step (ms); keep it above TIMEOUT. Cucumber's own default is only 5000
STEP_TIMEOUT=60000
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
# true = open the browser maximized (ignores VIEWPORT_WIDTH/HEIGHT, headed runs only)
START_MAXIMIZED=false

# Allure Configuration
ALLURE_RESULTS_DIR=allure-results
SCREENSHOT_ON_FAIL=true

# Database Configuration (PostgreSQL)
# Either set POSTGRES_CONNECTION_STRING, or the individual POSTGRES_* values below
# e.g. postgres://user:password@localhost:5432/mydb
POSTGRES_CONNECTION_STRING=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_NAME=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSL=false
POSTGRES_POOL_MAX=5
POSTGRES_QUERY_TIMEOUT=30000

# Email Notification Configuration
# When true, `npm test` (and every test:* script) generates the Allure report
# after the run and emails it to the recipients below.
EMAIL_NOTIFICATION=false
# When to send: always | failure | success
EMAIL_SEND_ON=always
# true = don't send, save the email as .eml under email-output/ to preview it
EMAIL_DRY_RUN=false

# SMTP server (Gmail: smtp.gmail.com / 587 / SMTP_SECURE=false, use an App Password)
# (Outlook/Office 365: smtp.office365.com / 587 / SMTP_SECURE=false)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# true for port 465 (SSL), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Sender and recipients (comma separated for multiple addresses)
EMAIL_FROM=QA Automation <qa.automation@example.com>
EMAIL_TO=lead@example.com,dev@example.com
EMAIL_CC=
EMAIL_BCC=

# Content
# Placeholders: {{projectName}} {{status}} {{total}} {{passed}} {{failed}} {{broken}}
# {{skipped}} {{passRate}} {{duration}} {{env}} {{baseUrl}} {{browser}} {{tags}}
# {{date}} {{host}}
EMAIL_SUBJECT=[{{status}}] {{projectName}} - {{passed}}/{{total}} passed ({{env}})
EMAIL_PROJECT_NAME=Playwright Automation
# HTML body template (same placeholders, plus {{failedTestsTable}} and {{reportNote}})
EMAIL_TEMPLATE_PATH=src/Framework/Report/email-templates/report-email.html
EMAIL_ATTACH_REPORT=true
# Skip the attachment if the report is bigger than this (most mail servers cap at 20-25 MB)
EMAIL_MAX_ATTACHMENT_MB=20

# Cucumber Configuration
CUCUMBER_TAGS=
CUCUMBER_PARALLEL=1

# Test Data
# Test data folder (Excel file and upload documents), relative to the project root
TEST_DATA_PATH=src/tests/test-data/

# Excel-driven test suite (npm run test:suite)
# Workbook file name (looked up in TEST_DATA_PATH) or a path, and the sheet to run.
# Both can be overridden per run: npm run test:suite -- --workbook X.xlsx --sheet TSEBDD
SUITE_WORKBOOK=TestSuite.xlsx
SUITE_SHEET=Regression
# Folder searched for the feature files named in the sheet
SUITE_FEATURES_DIR=src/tests/features
# true: when a scenario fails, skip the remaining scenarios of the same workflow
SUITE_STOP_WORKFLOW_ON_FAILURE=true

TEST_USERNAME=
TEST_PASSWORD=

