# Environment Configuration Example
# Copy this file to .env and update the values as needed

# Test Environment
NODE_ENV=local
LOG_LEVEL=INFO

# Application URLs
LOCAL_BASE_URL=https://www.daraz.pk/
DEV_BASE_URL=http://localhost:3000
STAGING_BASE_URL=https://staging.example.com
PROD_BASE_URL=https://prod.example.com

# Browser Configuration
BROWSER=chromium
HEADLESS=false
SLOW_MO=0
TIMEOUT=30000
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# Allure Configuration
ALLURE_RESULTS_DIR=allure-results
SCREENSHOT_ON_FAIL=true

# Database Configuration (PostgreSQL)
# Either set DB_CONNECTION_STRING, or the individual DB_* values below
# e.g. postgres://user:password@localhost:5432/mydb
DB_CONNECTION_STRING=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false
DB_POOL_MAX=5
DB_QUERY_TIMEOUT=30000

# Cucumber Configuration
CUCUMBER_TAGS=
CUCUMBER_PARALLEL=1

# Test Data (if needed)
TEST_USERNAME=
TEST_PASSWORD=

