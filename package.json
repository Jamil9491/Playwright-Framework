{
  "name": "ts-test-framework",
  "version": "1.0.0",
  "description": "A reusable TypeScript test automation framework using Cucumber, Playwright, and Allure",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js",
    "test:sample": "cucumber-js --tags \"@sample\"",
    "test:smoke": "cucumber-js --tags \"@smoke\"",
    "test:regression": "cucumber-js --tags \"@regression\"",
    "test:login": "cucumber-js --tags \"@authentication\"",
    "test:daraz": "cucumber-js --tags \"@daraz\"",
    "test:daraz:ui": "cucumber-js --tags \"@daraz-ui\"",
    "test:daraz:login": "cucumber-js --tags \"@daraz-login\"",
    "test:daraz:debug": "cross-env PWDEBUG=1 HEADLESS=false cucumber-js --tags \"@daraz-login\"",
    "test:ddt": "cucumber-js --tags \"@ddt\"",
    "test:todos": "cucumber-js --tags \"@todos\"",
    "test:parallel": "cucumber-js --parallel 2",
    "test:headless": "cross-env HEADLESS=true cucumber-js",
    "test:headed": "cross-env HEADLESS=false cucumber-js",
    "test:chrome": "cross-env BROWSER=chromium cucumber-js",
    "test:firefox": "cross-env BROWSER=firefox cucumber-js",
    "test:webkit": "cross-env BROWSER=webkit cucumber-js",
    "test:chrome:headed": "cross-env BROWSER=chromium HEADLESS=false cucumber-js",
    "test:firefox:headed": "cross-env BROWSER=firefox HEADLESS=false cucumber-js",
    "test:webkit:headed": "cross-env BROWSER=webkit HEADLESS=false cucumber-js",
    "allure:generate": "\"node_modules\\allure-commandline\\dist\\bin\\allure.bat\" generate allure-results --clean -o allure-report",
    "allure:open": "\"node_modules\\allure-commandline\\dist\\bin\\allure.bat\" open allure-report",
    "allure:serve": "\"node_modules\\allure-commandline\\dist\\bin\\allure.bat\" serve allure-results",
    "clean": "rimraf allure-results allure-report dist",
    "build": "tsc",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "typescript",
    "cucumber",
    "playwright",
    "allure",
    "bdd",
    "testing",
    "automation",
    "framework"
  ],
  "author": "Test Automation Team",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@cucumber/messages": "^31.0.0",
    "@playwright/test": "^1.56.1",
    "@types/dotenv": "^8.2.3",
    "@types/node": "^24.10.1",
    "allure-commandline": "^2.34.1",
    "allure-cucumberjs": "^3.4.2",
    "allure-js-commons": "^3.4.2",
    "allure-playwright": "^3.4.2",
    "cross-env": "^10.1.0",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "xlsx": "^0.18.5"
  }
}
