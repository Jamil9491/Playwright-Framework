{
  "name": "ts-test-framework",
  "version": "1.0.0",
  "description": "A reusable TypeScript test automation framework using Cucumber, Playwright, and Allure",
  "main": "index.js",
  "scripts": {
    "test": "ts-node src/Framework/scripts/runTests.ts",
    "test:sample": "ts-node src/Framework/scripts/runTests.ts --tags \"@sample\"",
    "test:smoke": "ts-node src/Framework/scripts/runTests.ts --tags \"@smoke\"",
    "test:regression": "ts-node src/Framework/scripts/runTests.ts --tags \"@regression\"",
    "test:login": "ts-node src/Framework/scripts/runTests.ts --tags \"@authentication\"",
    "test:daraz": "ts-node src/Framework/scripts/runTests.ts --tags \"@daraz\"",
    "test:daraz:ui": "ts-node src/Framework/scripts/runTests.ts --tags \"@daraz-ui\"",
    "test:daraz:login": "ts-node src/Framework/scripts/runTests.ts --tags \"@daraz-login\"",
    "test:tfs:login": "ts-node src/Framework/scripts/runTests.ts --tags \"@TFS-Login\"",
    "test:tfs:sight": "ts-node src/Framework/scripts/runTests.ts --tags \"@ilc-sight\"",
    "test:daraz:debug": "cross-env PWDEBUG=1 HEADLESS=false ts-node src/Framework/scripts/runTests.ts --tags \"@daraz-login\"",
    "test:ddt": "ts-node src/Framework/scripts/runTests.ts --tags \"@ddt\"",
    "test:todos": "ts-node src/Framework/scripts/runTests.ts --tags \"@todos\"",
    "test:parallel": "ts-node src/Framework/scripts/runTests.ts --parallel 2",
    "test:headless": "cross-env HEADLESS=true ts-node src/Framework/scripts/runTests.ts",
    "test:headed": "cross-env HEADLESS=false ts-node src/Framework/scripts/runTests.ts",
    "test:chrome": "cross-env BROWSER=chromium ts-node src/Framework/scripts/runTests.ts",
    "test:firefox": "cross-env BROWSER=firefox ts-node src/Framework/scripts/runTests.ts",
    "test:webkit": "cross-env BROWSER=webkit ts-node src/Framework/scripts/runTests.ts",
    "test:chrome:headed": "cross-env BROWSER=chromium HEADLESS=false ts-node src/Framework/scripts/runTests.ts",
    "test:firefox:headed": "cross-env BROWSER=firefox HEADLESS=false ts-node src/Framework/scripts/runTests.ts",
    "test:webkit:headed": "cross-env BROWSER=webkit HEADLESS=false ts-node src/Framework/scripts/runTests.ts",
    "allure:generate": "rimraf allure-report && allure generate",
    "allure:open": "allure open",
    "allure:serve": "allure open allure-results",
    "allure:watch": "allure watch allure-results",
    "test:report": "rimraf allure-results && allure run --open -- cucumber-js",
    "report:email": "ts-node src/Framework/scripts/sendReportEmail.ts",
    "clean": "rimraf allure-results allure-report dist",
    "build": "tsc",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "typescript",
    "cucumber",
    "playwright",
    "allure",
    "bdd",
    "testing",
    "automation",
    "framework"
  ],
  "author": "Test Automation Team",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@cucumber/messages": "^31.0.0",
    "@playwright/test": "^1.56.1",
    "@types/dotenv": "^8.2.3",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "allure": "^3.20.1",
    "allure-cucumberjs": "^3.13.0",
    "allure-js-commons": "^3.13.0",
    "cross-env": "^10.1.0",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "xlsx": "^0.18.5"
  }
}